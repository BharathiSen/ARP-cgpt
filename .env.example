# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` — it holds secrets.

# --- Required ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arp?schema=public"
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Optional: Redis (rate limits + cache). App works without it using memory fallback. ---
# REDIS_URL="redis://localhost:6379"
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# --- Optional: AI insights (falls back to heuristic analysis if missing) ---
# OPENAI_API_KEY=""

# --- Optional: admin allowlist (comma-separated). Also set isAdmin=true in DB. ---
# ADMIN_EMAIL="you@example.com"
# ADMIN_EMAILS="you@example.com,teammate@example.com"

# --- Optional: email (welcome / upgrade messages) ---
# RESEND_API_KEY=""

# --- Optional: Pro upgrades via Razorpay ---
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Optional: Playwright base URL (defaults to http://127.0.0.1:3000) ---
# PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"

# --- Optional: error monitoring ---
# NEXT_PUBLIC_SENTRY_DSN=""
